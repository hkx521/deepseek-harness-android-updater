<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.7 无障碍服务配置：给 AI 提供「读屏幕节点树 + 模拟操作 + 无障碍截图」能力。
  - canRetrieveWindowContent：读取窗口节点树（dump/tap 查找的基础）
  - canPerformGestures：任意坐标点击/滑动（dispatchGesture，API 24+）
  - canTakeScreenshot：Android 11+ 无障碍截图（免 MediaProjection 弹窗）
  - 批次19v2 加 typeViewClicked：TYPE_VIEW_CLICKED 是「点击监听真的执行」的强证据，环境噪音事件（content-changed）不能证明点击生效（高噪 WebView 界面实测 6/6 假成功，见 AccessibilityService.handleTap）
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeWindowsChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:canTakeScreenshot="true"
    android:notificationTimeout="200"
    android:description="@string/accessibility_service_description" />
