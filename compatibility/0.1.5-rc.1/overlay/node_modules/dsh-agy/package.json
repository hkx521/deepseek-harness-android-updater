{
  "name": "dsh-agy",
  "version": "0.2.6",
  "packageManager": "pnpm@11.10.0",
  "description": "Google Antigravity (agy) OAuth auth + model access plugin for DeepSeek Harness: multi-account pool, 429 rotation, device fingerprinting, CLI and web login.",
  "type": "module",
  "license": "MIT",
  "author": "chaos-03x <73626814+chaos-03x@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaos-03x/dsh-agy.git"
  },
  "bin": {
    "dsh-agy": "./bin/dsh-agy.js"
  },
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "record:fixtures": "tsx scripts/record-fixture.ts",
    "e2e": "tsx scripts/e2e.ts",
    "debug:request": "tsx scripts/debug-request.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "verify:tools": "tsx scripts/verify-tools.mts",
    "verify:blocks": "tsx scripts/verify-blocks.mts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^14.0.0",
    "proper-lockfile": "^4.1.2",
    "undici": "^7.29.0"
  },
  "optionalDependencies": {
    "socks-proxy-agent": "^8.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./web": {
      "types": "./lib/web/plugin.d.mts",
      "default": "./lib/web/plugin.mjs"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  }
}
